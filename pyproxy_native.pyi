from collections.abc import Callable

class Proxy:
    def __init__(self, port: int = 8080) -> None: ...

    def start(self) -> None: ...
    def stop(self) -> None: ...
    def restart(self) -> None: ...

    def add_restricted_sites(self, site: str) -> bool: ...
    def remove_restricted_sites(self, site: str) -> bool: ...
    def get_restricted_sites(self) -> list[str]: ...
    def set_event_callback(
        self, callback: Callable[[str, int], None] | None
    ) -> None: ...
